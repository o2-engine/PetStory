{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "JS Debugger: Attach",
            "type": "node",
            "request": "attach",
            "address": "localhost",
            "port": 5001,
            "localRoot": "${workspaceRoot}"
        },
        {
            "name": "macOS: PetStory",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Bin/Mac/PetStory",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Bin/Mac",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "setupCommands": [
                {
                    "description": "Load o2 LLDB formatters",
                    "text": "command script import ${workspaceFolder}/o2/Framework/Platforms/o2_lldb_formatters.py",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake: build macOS PetStory"
        },
        {
            "name": "macOS: Editor",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Bin/Mac/Editor",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Bin/Mac",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "setupCommands": [
                {
                    "description": "Load o2 LLDB formatters",
                    "text": "command script import ${workspaceFolder}/o2/Framework/Platforms/o2_lldb_formatters.py",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake: build macOS Editor"
        },
        {
            "name": "macOS: o2Tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Bin/Mac/o2Tests",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Bin/Mac",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "cmake: build macOS o2Tests"
        },
        {
            "name": "macOS: AssetsBuilder",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Bin/Mac/AssetsBuilder",
            "args": [
                "-platform", "Mac",
                "-source", "${workspaceFolder}/Assets/",
                "-target", "${workspaceFolder}/BuiltAssets/Mac/Data/",
                "-target-tree", "${workspaceFolder}/BuiltAssets/Mac/Data.json",
                "-compressor-config", "${workspaceFolder}/o2/CompressToolsConfig.json"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "cmake: build macOS AssetsBuilder"
        },
        {
            "name": "iOS Simulator: PetStory",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/Bin/iOS/PetStory.app/PetStory",
            "MIMode": "lldb",
            "setupCommands": [
                {
                    "description": "Load o2 LLDB formatters",
                    "text": "command script import ${workspaceFolder}/o2/Framework/Platforms/o2_lldb_formatters.py",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "ios: debug PetStory on simulator"
        }
    ]
}