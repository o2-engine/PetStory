{
    "version": 6,
    "configurePresets": [
        {
            "name": "mac",
            "displayName": "Mac (Debug)",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "O2_EDITOR": "ON",
                "O2_TESTS": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "mac-release",
            "displayName": "Mac (Release)",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "O2_EDITOR": "ON",
                "O2_TESTS": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows",
            "displayName": "Windows (Debug)",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "O2_EDITOR": "ON",
                "O2_TESTS": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows (Release)",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "O2_EDITOR": "ON",
                "O2_TESTS": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux",
            "displayName": "Linux (Debug)",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "O2_EDITOR": "ON",
                "O2_TESTS": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux (Release)",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "O2_EDITOR": "ON",
                "O2_TESTS": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "ios-sim",
            "displayName": "iOS Simulator (Debug)",
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build-ios-sim",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_SYSROOT": "iphonesimulator",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0",
                "O2_EDITOR": "OFF",
                "O2_TESTS": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "ios",
            "displayName": "iOS Device (Release)",
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build-ios",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_SYSROOT": "iphoneos",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0",
                "O2_EDITOR": "OFF",
                "O2_TESTS": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "wasm",
            "displayName": "WebAssembly (Release, -O3 LTO SIMD)",
            "binaryDir": "${sourceDir}/build-wasm",
            "environment": {
                "EMSDK": "$penv{HOME}/emsdk"
            },
            "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "O2_EDITOR": "OFF",
                "O2_TESTS": "OFF"
            }
        },
        {
            "name": "wasm-debug",
            "inherits": "wasm",
            "displayName": "WebAssembly (Debug, -O0 DWARF + safety checks)",
            "binaryDir": "${sourceDir}/build-wasm-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "mac",
            "configurePreset": "mac",
            "configuration": "Debug"
        },
        {
            "name": "mac-release",
            "configurePreset": "mac-release",
            "configuration": "Release"
        },
        {
            "name": "windows",
            "configurePreset": "windows",
            "configuration": "Debug"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release",
            "configuration": "Release"
        },
        {
            "name": "linux",
            "configurePreset": "linux",
            "configuration": "Debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "configuration": "Release"
        },
        {
            "name": "ios-sim",
            "configurePreset": "ios-sim",
            "configuration": "Debug",
            "targets": ["PetStory"]
        },
        {
            "name": "ios",
            "configurePreset": "ios",
            "configuration": "Release",
            "targets": ["PetStory"]
        },
        {
            "name": "wasm",
            "configurePreset": "wasm",
            "configuration": "Release",
            "targets": ["PetStory"]
        },
        {
            "name": "wasm-debug",
            "configurePreset": "wasm-debug",
            "configuration": "Debug",
            "targets": ["PetStory"]
        }
    ]
}
